APP_NAME="Qudroid Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL + PostGIS (run: CREATE EXTENSION postgis; in the new database)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qudroid_logistics
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First Super Admin (used by `php artisan db:seed`)
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments / messaging (set in the admin UI or here)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
TWILIO_SID=
TWILIO_TOKEN=

# Road routing for quotes/ETAs: straight (default, no dependency) or osrm
ROUTING_DRIVER=straight
OSRM_BASE_URL=http://osrm:5000

# SMS: set SMS_DRIVER=termii and fill the rest once your sender ID is approved
SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd
