APP_NAME="Qudroid Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Where this install operates: NG (Nigeria: NGN, +234, Lagos time) or CA (Canada: CAD, +1, Toronto time).
# Sets currency, phone format, time zone, provinces and default sales tax (config/region-presets.php).
REGION=CA
# REGION_TIMEZONE=America/Vancouver   (only to override the region's time zone)

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL + PostGIS (run: CREATE EXTENSION postgis; in the new database)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qudroid_logistics
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First Super Admin (used by `php artisan db:seed`)
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# company = one company with its own fleet, marketplace = outside providers compete, both = marketplace plus house fleet
PLATFORM_MODE=both
PLATFORM_HOUSE_OPERATOR_ID=

# Payments / messaging (set in the admin UI or here)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# SMS through Twilio (set SMS_DRIVER=twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Online payments: paystack | opay | monnify | stripe. Switch gateways on and enter their keys in Finance > Payment Gateways;
# the customer picks one when more than one is on. Webhook URLs to give each provider: /webhook/paystack, /webhook/opay, /webhook/monnify, /webhook/stripe
PAYMENTS_DEFAULT_GATEWAY=paystack
# STRIPE_CURRENCY=cad   (defaults to the region's currency)

# Road routing for quotes/ETAs: straight (default, no dependency) or osrm
ROUTING_DRIVER=straight
OSRM_BASE_URL=http://osrm:5000

# SMS: set SMS_DRIVER=termii and fill the rest once your sender ID is approved
# log | termii (Nigeria) | twilio (Canada and most other countries)
SMS_DRIVER=log
# WhatsApp for the same messages once switched on in Notification Settings: instead (WhatsApp, text as fallback) | also | off
SMS_WHATSAPP=instead
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd

PUSH_DRIVER=log
FCM_CREDENTIALS=

# Live fleet map and speed monitoring
TRACKING_SPEED_LIMIT_KMH=80
TRACKING_SPEEDING_COOLDOWN_MINUTES=15
TRACKING_FLEET_POLL_SECONDS=10
