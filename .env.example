APP_NAME="Qudroid Logistics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Where this install operates: NG (Nigeria: NGN, +234, Lagos time) or CA (Canada: CAD, +1, Toronto time).
# Sets currency, phone format, time zone, provinces and default sales tax (config/region-presets.php).
REGION=CA
# REGION_TIMEZONE=America/Vancouver   (only to override the region's time zone)

LOG_CHANNEL=stack
LOG_LEVEL=warning

# PostgreSQL + PostGIS (run: CREATE EXTENSION postgis; in the new database)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qudroid_logistics
DB_USERNAME=postgres
DB_PASSWORD=

# Everything runs on PostgreSQL to start. When traffic grows, move cache and queue to Redis (needs a Redis server and
# the phpredis PHP extension): CACHE_STORE=redis, QUEUE_CONNECTION=redis, then run `php artisan queue:restart`.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First Super Admin (used by `php artisan db:seed`)
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# company = one company with its own fleet, marketplace = outside providers compete, both = marketplace plus house fleet
PLATFORM_MODE=both
PLATFORM_HOUSE_OPERATOR_ID=

# Payments / messaging (set in the admin UI or here)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# SMS through Twilio (set SMS_DRIVER=twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Online payments: paystack | opay | monnify | stripe. Switch gateways on and enter their keys in Finance > Payment Gateways;
# the customer picks one when more than one is on. Webhook URLs to give each provider: /webhook/paystack, /webhook/opay, /webhook/monnify, /webhook/stripe
PAYMENTS_DEFAULT_GATEWAY=paystack
# STRIPE_CURRENCY=cad   (defaults to the region's currency)

# Road routing for prices and arrival times: auto (default: Google or Mapbox when that key is set below, else straight-line),
# google | mapbox | osrm (your own server) | straight. ROUTING_TRAFFIC=true uses live traffic (dearer).
ROUTING_DRIVER=auto
OSRM_BASE_URL=http://osrm:5000

# Address search and map tiles (config/maps.php): google (GOOGLE_MAPS_KEY with Places API (New) and Routes API) | mapbox | nominatim (testing only)
GEOCODER=google
GOOGLE_MAPS_KEY=
# MAPBOX_TOKEN=
# MAPBOX_PUBLIC_TOKEN=     (map tiles from Mapbox)
# MAP_TILE_URL=            (any Leaflet tile URL instead)

# Instant prices, drop-off stores, drivers: the operator whose price lists give instant prices, and the fleet approved drivers join
INSTANT_OPERATOR_ID=
# DRIVE_OPERATOR_ID=

# Contact buttons and "Talk to us" on the website
WHATSAPP_NUMBER=
CONTACT_PHONE=
CONTACT_EMAIL=
SALES_EMAIL=

# Bot check on the homepage price form (Cloudflare Turnstile; off when empty)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Website analytics (off when empty): plausible (PLAUSIBLE_DOMAIN) or ga4 (GA_MEASUREMENT_ID)
ANALYTICS=
PLAUSIBLE_DOMAIN=
GA_MEASUREMENT_ID=

# Backups: copy each one off this server ({file} = the backup's path), and whether backup emails may carry the file
BACKUP_COPY_COMMAND=
BACKUP_EMAIL_ATTACH=false

# App sign-ins unused for this many days are signed out
APP_TOKEN_IDLE_DAYS=60
SESSION_SECURE_COOKIE=true

# SMS: set SMS_DRIVER=termii and fill the rest once your sender ID is approved
# log | termii (Nigeria) | twilio (Canada and most other countries)
SMS_DRIVER=log
# WhatsApp for the same messages once switched on in Notification Settings: instead (WhatsApp, text as fallback) | also | off
SMS_WHATSAPP=instead
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd

# Push notifications: fcm with FCM_CREDENTIALS = path to the Firebase service-account JSON (kept outside git)
PUSH_DRIVER=log
FCM_CREDENTIALS=

# Live fleet map and speed monitoring
TRACKING_SPEED_LIMIT_KMH=80
TRACKING_SPEEDING_COOLDOWN_MINUTES=15
TRACKING_FLEET_POLL_SECONDS=10
