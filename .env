APP_NAME="Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12


# ============================================
# LOGGING
# ============================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# ============================================
# DATABASE - POSTGRESQL
# ============================================

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=logistics
DB_USERNAME=sail
DB_PASSWORD=password


# ============================================
# SESSION
# ============================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# ============================================
# BROADCASTING
# ============================================

BROADCAST_CONNECTION=reverb


# ============================================
# FILE STORAGE
# ============================================

FILESYSTEM_DISK=local


# ============================================
# QUEUE
# ============================================

QUEUE_CONNECTION=redis


# ============================================
# CACHE
# ============================================

CACHE_STORE=redis


# ============================================
# REDIS
# ============================================

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379


# ============================================
# MAIL - MAILPIT
# ============================================

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@logistics.test"
MAIL_FROM_NAME="${APP_NAME}"


# ============================================
# LARAVEL REVERB
# REAL-TIME / LIVE TRACKING
# ============================================

REVERB_APP_ID=logistics
REVERB_APP_KEY=logistics-local-key
REVERB_APP_SECRET=logistics-local-secret

REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http


# ============================================
# AWS / S3
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ============================================
# VITE
# ============================================

VITE_APP_NAME="${APP_NAME}"


# ============================================
# LOGISTICS APPLICATION
# ============================================

LOGISTICS_DEFAULT_CURRENCY=NGN
LOGISTICS_DEFAULT_COUNTRY=NG
LOGISTICS_TIMEZONE=Africa/Lagos


# ============================================
# DRIVER LOCATION
# ============================================

DRIVER_LOCATION_UPDATE_INTERVAL=10
DRIVER_LOCATION_RETENTION_DAYS=30


# ============================================
# MAPS
# ============================================

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_WEB_KEY=


# ============================================
# PAYMENT - PAYSTACK
# ============================================

PAYSTACK_ACTIVE=false
PAYSTACK_MODE=sandbox

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=

PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=

PAYSTACK_CALLBACK_URL=/payment/callback
PAYSTACK_WEBHOOK_URL=/payment/webhook/paystack


# ============================================
# FLUTTERWAVE
# ============================================

FLUTTERWAVE_ACTIVE=false
FLW_MODE=sandbox

FLW_SECRET_KEY=
FLW_PUBLIC_KEY=

FLW_TEST_SECRET_KEY=
FLW_TEST_PUBLIC_KEY=

FLW_LIVE_SECRET_KEY=
FLW_LIVE_PUBLIC_KEY=

FLW_ENCRYPTION_KEY=

FLW_CALLBACK_URL=/payment/callback/flutterwave
FLW_WEBHOOK_URL=/payment/webhook/flutterwave


# ============================================
# SMS
# ============================================

SMS_DRIVER=log

TERMII_API_KEY=
TERMII_SENDER=LOGISTICS


# ============================================
# WHATSAPP
# ============================================

WHATSAPP_DRIVER=log

WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en


# ============================================
# PUSH NOTIFICATIONS
# ============================================

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=


# ============================================
# DISPATCH
# ============================================

DISPATCH_AUTO_ASSIGN=true
DISPATCH_MAX_DISTANCE_KM=10
DISPATCH_ASSIGNMENT_TIMEOUT=60


# ============================================
# API
# ============================================

API_RATE_LIMIT=60


# ============================================
# DEVELOPMENT
# ============================================

SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG="client_host=host.docker.internal"

WWWUSER=1000
WWWGROUP=1000

APP_PORT=80
VITE_PORT=5173
REVERB_PORT=8080
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
MAILPIT_PORT=8025
